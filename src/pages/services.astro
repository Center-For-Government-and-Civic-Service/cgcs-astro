---
import BaseLayout from '../layouts/BaseLayout.astro';
import { testimonials } from '../data/testimonials';

const serviceTiers = [
  {
    title: 'Tabletop Exercises',
    description: 'Guided scenario discussions brought into your classroom. We work with professors to design exercises tailored to course topics — from public policy dilemmas to cybersecurity incidents.',
    bestFor: 'ACC faculty, college classrooms',
    format: '1-2 hour in-class sessions',
    cta: 'Request a Tabletop Exercise',
    serviceValue: 'tabletop',
    icon: 'tabletop',
    tier: 1,
  },
  {
    title: 'Simulations',
    description: 'Immersive role-play experiences where participants navigate real-world challenges — conflict resolution, risk management, crisis response, community decision-making.',
    bestFor: 'Classes, nonprofits, businesses, community groups',
    format: 'Half-day or full-day events, on-site or at CGCS',
    cta: 'Request a Simulation',
    serviceValue: 'simulation',
    icon: 'simulation',
    tier: 2,
  },
  {
    title: 'Workforce Development',
    description: 'Comprehensive programs combining multiple engagements — skill building, organizational development, and team strengthening through sustained simulation-based learning.',
    bestFor: 'Businesses, organizations, government agencies',
    format: 'Multi-session programs, custom scoped',
    cta: 'Request a Program',
    serviceValue: 'workforce',
    icon: 'workforce',
    tier: 3,
  },
];

const processSteps = [
  {
    number: '1',
    title: 'Connect',
    description: 'Reach out and tell us about your class, team, or organization',
  },
  {
    number: '2',
    title: 'Customize',
    description: 'We design a scenario tailored to your specific goals and topics',
  },
  {
    number: '3',
    title: 'Experience',
    description: 'We facilitate the exercise with your group and debrief together',
  },
];
---

<BaseLayout title="Services" description="From tabletop exercises to full-scale simulations, CGCS partners with you to design immersive learning experiences that build critical skills.">

  <!-- Hero Section -->
  <section
    class="relative min-h-[40vh] flex items-center justify-center py-16"
    style="background-image: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('/images/services-hero.png'); background-size: cover; background-position: center;"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6" style="font-family: 'Montserrat', sans-serif;">
        Bring Real-World Scenarios to Your Classroom or Organization
      </h1>
      <p class="text-lg md:text-xl text-white/90 mb-2 max-w-2xl mx-auto">
        Immersive learning experiences that build critical skills.
      </p>
      <p class="text-base text-white/70 mb-8">
        Tailored to your needs.
      </p>
      <a
        href="#services"
        class="btn-primary inline-flex items-center gap-2"
        id="hero-cta"
      >
        Explore Our Services
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Service Tier Cards -->
  <section id="services" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-text-dark text-center mb-4">Our Services</h2>
      <p class="text-text-light text-center mb-12 max-w-2xl mx-auto">
        Choose the engagement level that fits your needs — from focused classroom exercises to comprehensive development programs.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" role="list">
        {serviceTiers.map((tier) => (
          <div
            class:list={[
              'service-card rounded-2xl p-8 flex flex-col h-full transition-all duration-300 hover:-translate-y-1',
              tier.tier === 3
                ? 'bg-primary/5 border-2 border-primary shadow-lg'
                : tier.tier === 2
                  ? 'bg-white border-2 border-gray-200 shadow-md hover:border-primary/40'
                  : 'bg-white border border-gray-200 shadow-sm hover:border-primary/40'
            ]}
            role="listitem"
          >
            <!-- Icon -->
            <div class:list={[
              'w-14 h-14 rounded-xl flex items-center justify-center mb-5',
              tier.tier === 3 ? 'bg-primary/15' : 'bg-accent-teal/10'
            ]}>
              {tier.icon === 'tabletop' && (
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
                </svg>
              )}
              {tier.icon === 'simulation' && (
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                </svg>
              )}
              {tier.icon === 'workforce' && (
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
                </svg>
              )}
            </div>

            <!-- Content -->
            <h3 class="text-xl font-bold text-text-dark mb-3">{tier.title}</h3>
            <p class="text-text-light mb-5 flex-1">{tier.description}</p>

            <!-- Meta -->
            <div class="space-y-2 mb-6 text-sm">
              <div class="flex items-start gap-2">
                <span class="font-semibold text-text-dark whitespace-nowrap">Best for:</span>
                <span class="text-text-light">{tier.bestFor}</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="font-semibold text-text-dark whitespace-nowrap">Format:</span>
                <span class="text-text-light">{tier.format}</span>
              </div>
            </div>

            <!-- CTA -->
            <button
              class:list={[
                'service-cta w-full justify-center mt-auto',
                tier.tier === 3 ? 'btn-primary' : 'btn-outline'
              ]}
              data-service={tier.serviceValue}
            >
              {tier.cta}
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-text-dark text-center mb-12">How It Works</h2>

      <div class="process-steps flex flex-col md:flex-row items-start md:items-center justify-between gap-8 md:gap-4">
        {processSteps.map((step, i) => (
          <>
            <div class="flex flex-col items-center text-center flex-1">
              <div class="w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center text-2xl font-bold mb-4">
                {step.number}
              </div>
              <h3 class="text-xl font-bold text-text-dark mb-2">{step.title}</h3>
              <p class="text-text-light text-sm max-w-[200px]">{step.description}</p>
            </div>
            {i < processSteps.length - 1 && (
              <div class="hidden md:block flex-shrink-0 w-16 h-[2px] bg-primary/30 mt-[-2rem]" />
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="py-20 bg-white" aria-label="Testimonials">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-text-dark text-center mb-12">What People Are Saying</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {testimonials.map((t) => (
            <div class="bg-gray-50 rounded-2xl p-8 flex flex-col" aria-roledescription="testimonial">
              <svg class="w-8 h-8 text-primary/30 mb-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z" />
              </svg>
              <p class="text-text-dark italic mb-6 flex-1">"{t.quote}"</p>
              <div class="border-t border-gray-200 pt-4">
                <p class="font-semibold text-text-dark">{t.name}</p>
                <p class="text-sm text-text-light">{t.title}, {t.organization}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Inquiry Form -->
  <section id="inquiry" class="py-20 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-text-dark text-center mb-4">Get Started</h2>
      <p class="text-text-light text-center mb-10 max-w-xl mx-auto">
        Tell us about your class, team, or organization and we'll work with you to design the right experience.
      </p>

      <div class="bg-accent-teal/10 rounded-3xl p-8 md:p-12">
        <form class="space-y-6" id="services-inquiry-form">
          <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="New Services Inquiry — CGCS Website" />
          <input type="hidden" name="from_name" value="CGCS Services Form" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="firstName" class="block text-sm font-medium text-text-dark mb-1">First Name *</label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
              />
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-text-dark mb-1">Last Name *</label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-text-dark mb-1">Email *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
            />
          </div>

          <div>
            <label for="organization" class="block text-sm font-medium text-text-dark mb-1">Organization / Department *</label>
            <input
              type="text"
              id="organization"
              name="organization"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
            />
          </div>

          <div>
            <label for="service-select" class="block text-sm font-medium text-text-dark mb-1">Service Interest *</label>
            <select
              id="service-select"
              name="serviceInterest"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white"
            >
              <option value="" disabled selected>Select a service...</option>
              <option value="tabletop">Tabletop Exercise</option>
              <option value="simulation">Simulation</option>
              <option value="workforce">Workforce Development</option>
              <option value="unsure">Not Sure Yet</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-text-dark mb-1">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent resize-none"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full justify-center">
            Submit Inquiry
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- Success Message (hidden by default) -->
        <div id="form-success" class="hidden text-center py-12">
          <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-text-dark mb-2">Thank you!</h3>
          <p class="text-text-light">We'll be in touch soon to discuss how we can work together.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Hero CTA smooth scroll
    document.getElementById('hero-cta')?.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('services')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Service card CTA — scroll to form and pre-select service
    document.querySelectorAll('.service-cta').forEach((btn) => {
      btn.addEventListener('click', () => {
        const service = (btn as HTMLElement).dataset.service;
        const select = document.getElementById('service-select') as HTMLSelectElement;
        if (select && service) {
          select.value = service;
        }
        document.getElementById('inquiry')?.scrollIntoView({ behavior: 'smooth' });
        // Focus the first field after scroll
        setTimeout(() => {
          (document.getElementById('firstName') as HTMLInputElement)?.focus();
        }, 600);
      });
    });

    // Pre-select from URL query params (for external links)
    const params = new URLSearchParams(window.location.search);
    const serviceParam = params.get('service');
    if (serviceParam) {
      const select = document.getElementById('service-select') as HTMLSelectElement;
      const validValues = ['tabletop', 'simulation', 'workforce', 'unsure'];
      if (select && validValues.includes(serviceParam)) {
        select.value = serviceParam;
      }
    }

    // Form submission via Web3Forms
    const form = document.getElementById('services-inquiry-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json();

        if (data.success) {
          form.classList.add('hidden');
          successMsg?.classList.remove('hidden');
        } else {
          alert('Something went wrong. Please try again or email admin@cgcsacc.org directly.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Inquiry';
          }
        }
      } catch {
        alert('Something went wrong. Please try again or email admin@cgcsacc.org directly.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Inquiry';
        }
      }
    });
  </script>
</BaseLayout>
