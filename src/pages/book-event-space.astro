---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Book an Event Space">
  <!-- Header -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-accent-orange font-medium mb-4">Leadership – Education – Service</p>
          <h1 class="text-4xl md:text-5xl font-bold text-text-dark mb-6">Want to use our Event Space?</h1>
          <p class="text-lg text-text-light">
            <strong class="text-text-dark">We're here to connect, collaborate, and support.</strong> The Center for Government and Civic Service (CGCS) welcomes inquiries from students, staff, faculty, partners, and community members. Please provide us with initial event details.
          </p>
        </div>
        <div class="overflow-hidden rounded-2xl shadow-lg">
          <img
            src="/images/event-space-venue.jpg"
            alt="CGCS Event Space Venue"
            class="w-full h-80 md:h-96 object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- GOOGLE CALENDAR HIDDEN START
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-text-dark text-center mb-3">Check Our Availability</h2>
      <p class="text-text-light text-center mb-6">
        Review our calendar before booking. Colored blocks indicate the space is already reserved.
      </p>
      <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-200">
        <iframe
          src="https://calendar.google.com/calendar/embed?src=c_afaea34169f9e252afd545081e551f140dcefa691c2a8fcd8c6f9cec1c0c4f9d%40group.calendar.google.com&ctz=America%2FChicago&mode=WEEK"
          style="border: 0"
          width="100%"
          height="500"
          frameborder="0"
          scrolling="no"
          loading="lazy"
          class="w-full"
          title="CGCS Events Calendar"
        ></iframe>
      </div>
    </div>
  </section>
  GOOGLE CALENDAR HIDDEN END -->

  <!-- Booking Form Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-12">

        <div id="availability-banner" class="flex items-center gap-3 bg-primary/10 border border-primary/20 rounded-2xl px-4 py-3 mb-8 text-sm text-text-dark">
          <span aria-hidden="true">📅</span>
          <p class="flex-1"><strong>2026 is fully booked.</strong> We're now taking requests for 2027 dates.</p>
          <button id="banner-dismiss" type="button" aria-label="Dismiss availability notice" class="text-text-dark/50 hover:text-text-dark text-lg leading-none">&times;</button>
        </div>
        <button id="banner-restore" type="button" hidden class="text-xs text-primary underline mb-8">
          Show availability notice again
        </button>

        <h2 class="text-2xl md:text-3xl font-bold text-text-dark mb-4">When's your event?</h2>
        <div id="year-toggle" role="group" aria-label="Select event year" class="inline-flex bg-gray-100 rounded-full p-1 gap-1 mb-8">
          <button type="button" data-yr="2026" class="year-btn px-5 py-2 rounded-full text-sm font-semibold text-text-light transition-colors">2026</button>
          <button type="button" data-yr="2027" class="year-btn px-5 py-2 rounded-full text-sm font-semibold text-text-dark bg-white shadow-sm transition-colors">2027</button>
        </div>

        <div id="content-2027">
          <p class="text-text-light mb-8">
            Reservations are managed through Austin Community College's official request system. The form covers all event details and typically takes <strong class="text-text-dark">up to 10-15 minutes</strong> to complete. Have the following ready before you begin:
          </p>

          <ul class="space-y-3 mb-10">
            {[
              'Your name, email, and phone number',
              'Preferred event date(s) and times',
              'Estimated number of attendees',
              'A/V, catering, and room setup needs',
              'Your organization or department name',
            ].map(item => (
              <li class="flex items-start gap-3 text-text-light">
                <svg class="w-5 h-5 text-accent-teal flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <a
            href="https://app.smartsheet.com/b/form/cd2f5559c5b6458fbfe61490f4a90f93"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center gap-2 text-base"
          >
            Open Event Request Form
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <p class="text-sm text-text-light mt-6 italic">
            Event requests are not guaranteed until full payment is received. Please allow 1–4 business days for a response.
          </p>
        </div>

        <div id="content-2026" hidden>
          <p class="text-text-dark font-semibold mb-2">2026 is fully booked.</p>
          <p class="text-text-light mb-6">
            There's no formal waitlist — the fastest way to catch an opening is to check back here. 2027 has plenty of dates open right now.
          </p>
          <button id="switch-2027" type="button" class="btn-outline text-base">
            See 2027 options
          </button>
        </div>

        <script>
          const yearButtons = document.querySelectorAll<HTMLButtonElement>('#year-toggle .year-btn');
          const content2027 = document.getElementById('content-2027')!;
          const content2026 = document.getElementById('content-2026')!;

          function setYear(yr: string) {
            yearButtons.forEach((btn) => {
              const active = btn.dataset.yr === yr;
              btn.classList.toggle('bg-white', active);
              btn.classList.toggle('shadow-sm', active);
              btn.classList.toggle('text-text-dark', active);
              btn.classList.toggle('text-text-light', !active);
            });
            content2027.hidden = yr !== '2027';
            content2026.hidden = yr !== '2026';
          }

          yearButtons.forEach((btn) => btn.addEventListener('click', () => setYear(btn.dataset.yr!)));
          document.getElementById('switch-2027')?.addEventListener('click', () => setYear('2027'));

          const banner = document.getElementById('availability-banner')!;
          const bannerDismiss = document.getElementById('banner-dismiss')!;
          const bannerRestore = document.getElementById('banner-restore')!;
          bannerDismiss.addEventListener('click', () => {
            banner.hidden = true;
            bannerRestore.hidden = false;
          });
          bannerRestore.addEventListener('click', () => {
            banner.hidden = false;
            bannerRestore.hidden = true;
          });
        </script>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="h-96 bg-gray-200">
    <iframe
      src="https://www.google.com/maps?q=1218+West+Ave,+Austin,+TX+78701&output=embed"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="CGCS Location Map"
    ></iframe>
  </section>
</BaseLayout>
