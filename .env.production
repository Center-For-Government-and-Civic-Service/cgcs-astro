# Web3Forms access keys — PUBLIC by design (served in client-side HTML/JS to
# every visitor; they are aliases to recipient inboxes, not secrets).
# Committed so Cloudflare Pages CI builds (git push + scheduled rebuilds) bake
# them in; without this, CI builds ship an empty access_key and the form 500s.
PUBLIC_WEB3FORMS_KEY=c11e3f5f-bdbb-40ea-a24d-78338b1bc147
PUBLIC_WEB3FORMS_KEY_MARISELA=3f2dc2b3-2e18-4d77-8a56-25ef59a5e93c

# Apps Script /exec URL for newsletter → Google Sheet (public by design, same
# trust model as the Web3Forms keys) — see docs/newsletter-sheet/SETUP.md.
PUBLIC_NEWSLETTER_SHEET_URL=https://script.google.com/macros/s/AKfycbzYEZc10gN5An5r8ZeaFDm_kb2tBRbOmVeiQDdRZy4x_Nb1Vdb6cCXg1anOvgQuo46V/exec
